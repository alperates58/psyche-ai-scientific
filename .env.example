DATABASE_URL="postgresql://postgres:postgres@localhost:5433/psyche_ai?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/psyche_ai_test?schema=public"
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
RESEARCH_ACCESS_KEY=

# Auth.js / NextAuth Configuration
AUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth 2.0 (Optional in dev, required for Google Login)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email Delivery / SMTP (Optional in dev, uses mail sink fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PsycheAI <noreply@psikoai.alperates.com.tr>"

# Rate Limiting & Audit Security
AUTH_RATE_LIMIT_SECRET=
