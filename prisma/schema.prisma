datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ---------------------------------------------------------
// USER & IDENTITY
// ---------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  emailNormalized String?   @unique
  name            String
  image           String?
  emailVerified   DateTime?
  status          String    @default("ACTIVE") // ACTIVE, PENDING_VERIFICATION, SUSPENDED, DISABLED
  isDemoUser      Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  credential   UserCredential?
  roles        UserRole[]
  authAccounts Account[]
  authSessions Session[]
  consents     UserConsent[]
  emailTokens  EmailVerificationToken[]
  resetTokens  PasswordResetToken[]
  auditEvents  AuthAuditEvent[]

  // Preserved existing scientific relations
  sessions  AssessmentSession[]
  snapshots ProfileSnapshot[]

  // FAZ 2.7C Scientific Governance Relations
  scientificAuditEvents       ScientificAuditEvent[]   @relation("ScientificAuditActor")
  verifiedValidationSummaries FacetValidationSummary[] @relation("ValidationSummaryVerifier")

  // FAZ 2.21 User Reflection & Journal Relations
  journalEntries  JournalEntry[]
  journalInsights JournalInsight[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  revokedAt    DateTime?
  ipHash       String?
  userAgent    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserCredential {
  id                String   @id @default(cuid())
  userId            String   @unique
  passwordHash      String   @db.Text
  passwordUpdatedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      String // USER, EXPERT_REVIEWER, RESEARCHER, ADMIN, SUPER_ADMIN
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AuthAuditEvent {
  id          String   @id @default(cuid())
  eventType   String
  userId      String?
  actorUserId String?
  success     Boolean
  ipHash      String?
  userAgent   String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("auth_audit_events")
}

model UserConsent {
  id              String    @id @default(cuid())
  userId          String
  consentType     String
  documentVersion String
  acceptedAt      DateTime  @default(now())
  withdrawnAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

model RateLimitRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@map("rate_limit_records")
}

// ---------------------------------------------------------
// PSYCHOLOGICAL ONTOLOGY (Source-of-truth from data/constructs.json)
// ---------------------------------------------------------

model Domain {
  id            String  @id
  code          String  @unique
  nameTr        String
  nameEn        String
  descriptionTr String  @db.Text
  descriptionEn String  @db.Text
  color         String?
  sortOrder     Int     @default(0)

  constructs   Construct[]
  domainScores DomainScore[]

  @@map("domains")
}

model Construct {
  id            String @id
  code          String @unique
  domainId      String
  domain        Domain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  nameTr        String
  nameEn        String
  descriptionTr String @db.Text
  descriptionEn String @db.Text
  sortOrder     Int    @default(0)

  facets          Facet[]
  constructScores ConstructScore[]

  @@map("constructs")
}

model Facet {
  id            String    @id
  code          String    @unique
  constructId   String
  construct     Construct @relation(fields: [constructId], references: [id], onDelete: Restrict)
  nameTr        String
  nameEn        String
  descriptionTr String    @db.Text
  descriptionEn String    @db.Text
  sortOrder     Int       @default(0)

  items             Item[]
  facetScores       FacetScore[]
  scientificSources FacetScientificSource[]
  instruments       FacetInstrument[]
  theoryLenses      FacetTheoryLens[]

  // FAZ 2.7C Reverse Relation (1:1 with FacetValidationSummary)
  validationSummary FacetValidationSummary?

  @@map("facets")
}

// ---------------------------------------------------------
// SCIENTIFIC REGISTRY, INSTRUMENTS & THEORY LENSES
// ---------------------------------------------------------

model ScientificSource {
  id       String  @id
  shortKey String  @unique
  citation String  @db.Text
  year     Int?
  doi      String?
  url      String?

  facets       FacetScientificSource[]
  theoryLenses TheoryLensScientificSource[]

  // FAZ 2.7C Reverse Relations
  validationStudyEvidences       FacetValidationStudyEvidence[]
  validationReliabilityEvidences FacetReliabilityEvidence[]

  @@map("scientific_sources")
}

model FacetScientificSource {
  facetId  String
  sourceId String
  facet    Facet            @relation(fields: [facetId], references: [id], onDelete: Cascade)
  source   ScientificSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([facetId, sourceId])
  @@map("facet_scientific_sources")
}

model Instrument {
  id                String  @id
  code              String  @unique
  name              String
  fullName          String?
  licenseType       String
  licensingDecision String // "approved", "rejected", "restricted"
  citation          String? @db.Text

  facets FacetInstrument[]
  items  Item[]

  // FAZ 2.7C Reverse Relations
  validationStudyEvidences           FacetValidationStudyEvidence[]
  validationReliabilityEvidences     FacetReliabilityEvidence[]
  targetConstructValidationSummaries FacetValidationSummary[]       @relation("TargetConstructInstrument")
  supportingValidationSummaries      FacetValidationSummary[]       @relation("SupportingEvidenceInstrument")

  @@map("instruments")
}

model FacetInstrument {
  facetId      String
  instrumentId String
  facet        Facet      @relation(fields: [facetId], references: [id], onDelete: Cascade)
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@id([facetId, instrumentId])
  @@map("facet_instruments")
}

model TheoryLens {
  id           String  @id
  lensId       String  @unique // e.g. "jungian", "attachment"
  school       String
  theorist     String
  description  String  @db.Text
  primaryFocus String?

  facets            FacetTheoryLens[]
  scientificSources TheoryLensScientificSource[]

  @@map("theory_lenses")
}

model FacetTheoryLens {
  facetId      String
  theoryLensId String
  facet        Facet      @relation(fields: [facetId], references: [id], onDelete: Cascade)
  theoryLens   TheoryLens @relation(fields: [theoryLensId], references: [id], onDelete: Cascade)

  @@id([facetId, theoryLensId])
  @@map("facet_theory_lenses")
}

model TheoryLensScientificSource {
  theoryLensId String
  sourceId     String
  theoryLens   TheoryLens       @relation(fields: [theoryLensId], references: [id], onDelete: Cascade)
  source       ScientificSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([theoryLensId, sourceId])
  @@map("theory_lens_scientific_sources")
}

// ---------------------------------------------------------
// ITEM BANK WITH DEEP VERSIONING
// ---------------------------------------------------------

model Item {
  id               String      @id @default(cuid())
  itemCode         String      @unique
  facetId          String
  facet            Facet       @relation(fields: [facetId], references: [id], onDelete: Restrict)
  instrumentId     String?
  instrument       Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  isKeyed          Boolean     @default(true) // true = regular (+), false = reverse (-)
  itemType         String      @default("LIKERT_5")
  isAttentionCheck Boolean     @default(false)
  createdAt        DateTime    @default(now())

  versions  ItemVersion[]
  responses ResponseRecord[]

  @@map("items")
}

model ItemVersion {
  id               String    @id @default(cuid())
  itemId           String
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  versionNumber    Int       @default(1)
  promptTr         String    @db.Text
  promptEn         String    @db.Text
  status           String    @default("DRAFT") // "DRAFT", "ACTIVE", "DEPRECATED"
  validationStatus String    @default("RESEARCH_DRAFT") // "RESEARCH_DRAFT", "VALIDATED", "DEPRECATED", "PRE_CALIBRATION"
  licenseStatus    String    @default("UNKNOWN") // "APPROVED_PUBLIC", "REQUIRES_LICENSE", "REJECTED_PROPRIETARY", "UNKNOWN"
  authorType       String? // "HUMAN_EXPERT", "GENERATIVE_AI", "ADAPTATION", "LEGACY_UNSPECIFIED"
  sourceType       String?
  notes            String?   @db.Text
  isActive         Boolean   @default(false)
  deprecatedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  options   ItemVersionOption[]
  formItems AssessmentFormItem[]
  responses ResponseRecord[]

  @@unique([itemId, versionNumber])
  @@index([status, validationStatus])
  @@map("item_versions")
}

model ItemVersionOption {
  id            String      @id @default(cuid())
  itemVersionId String
  itemVersion   ItemVersion @relation(fields: [itemVersionId], references: [id], onDelete: Cascade)
  value         Int // 1, 2, 3, 4, 5
  labelTr       String
  labelEn       String
  sortOrder     Int         @default(0)

  responses ResponseRecord[]
  revisions ResponseRevision[]

  @@unique([itemVersionId, value])
  @@map("item_version_options")
}

// ---------------------------------------------------------
// ASSESSMENT FORM FREEZE & MODULES
// ---------------------------------------------------------

model AssessmentModule {
  id               String @id @default(cuid())
  code             String @unique // e.g. "MODULE_1_CORE_PERSONALITY"
  titleTr          String
  titleEn          String
  descriptionTr    String @db.Text
  descriptionEn    String @db.Text
  estimatedMinutes Int    @default(15)

  formVersions AssessmentFormVersion[]

  @@map("assessment_modules")
}

model AssessmentFormVersion {
  id          String           @id @default(cuid())
  moduleId    String
  module      AssessmentModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  versionCode String // e.g. "v1.0.0"
  status      String           @default("DRAFT") // "DRAFT", "PUBLISHED", "ARCHIVED"
  isPublished Boolean          @default(false)
  itemCount   Int              @default(0)
  description String?          @db.Text
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  items    AssessmentFormItem[]
  sessions AssessmentSession[]

  @@unique([moduleId, versionCode])
  @@index([status])
  @@map("assessment_form_versions")
}

model AssessmentFormItem {
  id            String                @id @default(cuid())
  formVersionId String
  formVersion   AssessmentFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  itemVersionId String
  itemVersion   ItemVersion           @relation(fields: [itemVersionId], references: [id], onDelete: Restrict)
  sortOrder     Int

  responses ResponseRecord[]

  @@unique([formVersionId, sortOrder])
  @@unique([formVersionId, itemVersionId])
  @@map("assessment_form_items")
}

// ---------------------------------------------------------
// RUNTIME SESSION, RESPONSES & REVISION AUDIT
// ---------------------------------------------------------

model AssessmentSession {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  formVersionId   String
  formVersion     AssessmentFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  status          String                @default("IN_PROGRESS") // "IN_PROGRESS", "PAUSED", "COMPLETED", "ABANDONED"
  startedAt       DateTime              @default(now())
  lastActiveAt    DateTime              @default(now())
  completedAt     DateTime?
  totalDurationMs Int                   @default(0)
  currentStep     Int                   @default(1)

  responses        ResponseRecord[]
  telemetries      ResponseTelemetry[]
  integrityResults ResponseIntegrityResult[]
  snapshotSessions ProfileSnapshotSession[]

  @@map("assessment_sessions")
}

model ResponseRecord {
  id                      String             @id @default(cuid())
  sessionId               String
  session                 AssessmentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId                  String
  item                    Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemVersionId           String
  itemVersion             ItemVersion        @relation(fields: [itemVersionId], references: [id], onDelete: Restrict)
  formItemId              String
  formItem                AssessmentFormItem @relation(fields: [formItemId], references: [id], onDelete: Restrict)
  selectedOptionVersionId String
  selectedOption          ItemVersionOption  @relation(fields: [selectedOptionVersionId], references: [id], onDelete: Restrict)
  rawValue                Int
  scoredValue             Float
  revisionCount           Int                @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  revisions   ResponseRevision[]
  telemetries ResponseTelemetry[]

  @@unique([sessionId, formItemId])
  @@map("response_records")
}

model ResponseRevision {
  id                      String            @id @default(cuid())
  responseRecordId        String
  responseRecord          ResponseRecord    @relation(fields: [responseRecordId], references: [id], onDelete: Cascade)
  sequence                Int
  rawValue                Int
  selectedOptionVersionId String
  selectedOption          ItemVersionOption @relation(fields: [selectedOptionVersionId], references: [id], onDelete: Restrict)
  durationMs              Int?
  changedAt               DateTime          @default(now())

  @@unique([responseRecordId, sequence])
  @@map("response_revisions")
}

model ResponseTelemetry {
  id                       String            @id @default(cuid())
  sessionId                String
  session                  AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responseRecordId         String?
  responseRecord           ResponseRecord?   @relation(fields: [responseRecordId], references: [id], onDelete: Cascade)
  clientObservedDurationMs Int
  focusLostCount           Int               @default(0)
  firstInteractionAt       DateTime?
  serverReceivedAt         DateTime          @default(now())
  telemetryTrust           String            @default("client_observed")

  @@map("response_telemetry")
}

model ResponseIntegrityResult {
  id                      String            @id @default(cuid())
  sessionId               String
  session                 AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallFlag             String            @default("ACCEPTABLE") // "EXCELLENT", "ACCEPTABLE", "QUESTIONABLE", "COMPROMISED"
  speedViolations         Int               @default(0)
  medianDurationMs        Float             @default(0)
  longestStreak           Int               @default(0)
  straightliningDetected  Boolean           @default(false)
  inconsistencyPairsCount Int               @default(0)
  inconsistencyViolations Int               @default(0)
  attentionCheckPassed    Boolean           @default(true)
  computedAt              DateTime          @default(now())

  @@map("response_integrity_results")
}

// ---------------------------------------------------------
// PRE-CALIBRATION SCORING & PROFILE SNAPSHOTS
// ---------------------------------------------------------

model NormVersion {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  status       String   @default("UNAVAILABLE")
  isCalibrated Boolean  @default(false)
  sampleSize   Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("norm_versions")
}

model ScoringModelVersion {
  id               String   @id @default(cuid())
  code             String   @unique // e.g. "PRE_CALIBRATION_MEAN_V1"
  description      String   @db.Text
  algorithm        String   @default("UNWEIGHTED_COMPOSITE_MEAN")
  isPreCalibration Boolean  @default(true)
  createdAt        DateTime @default(now())

  snapshots ProfileSnapshot[]

  @@map("scoring_model_versions")
}

model ProfileSnapshot {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  scoringModelVersionId String
  scoringModelVersion   ScoringModelVersion @relation(fields: [scoringModelVersionId], references: [id], onDelete: Restrict)
  overallIntegrity      String              @default("ACCEPTABLE")
  provisionalComposite  Float // unweighted mean across domains
  normStatus            String              @default("UNAVAILABLE") // strictly UNAVAILABLE in pre-calibration
  standardError         Float? // strictly NULL in pre-calibration
  ci95Lower             Float? // strictly NULL in pre-calibration
  ci95Upper             Float? // strictly NULL in pre-calibration
  createdAt             DateTime            @default(now())

  sessions        ProfileSnapshotSession[]
  facetScores     FacetScore[]
  constructScores ConstructScore[]
  domainScores    DomainScore[]

  @@map("profile_snapshots")
}

model ProfileSnapshotSession {
  profileSnapshotId   String
  assessmentSessionId String
  profileSnapshot     ProfileSnapshot   @relation(fields: [profileSnapshotId], references: [id], onDelete: Cascade)
  assessmentSession   AssessmentSession @relation(fields: [assessmentSessionId], references: [id], onDelete: Cascade)

  @@id([profileSnapshotId, assessmentSessionId])
  @@map("profile_snapshot_sessions")
}

model FacetScore {
  id                String          @id @default(cuid())
  profileSnapshotId String
  profileSnapshot   ProfileSnapshot @relation(fields: [profileSnapshotId], references: [id], onDelete: Cascade)
  facetId           String
  facet             Facet           @relation(fields: [facetId], references: [id], onDelete: Restrict)
  rawMean           Float
  itemCount         Int
  standardError     Float? // strictly NULL in pre-calibration
  ci95Lower         Float? // strictly NULL in pre-calibration
  ci95Upper         Float? // strictly NULL in pre-calibration
  normVersionId     String? // strictly NULL in pre-calibration

  @@unique([profileSnapshotId, facetId])
  @@map("facet_scores")
}

model ConstructScore {
  id                String          @id @default(cuid())
  profileSnapshotId String
  profileSnapshot   ProfileSnapshot @relation(fields: [profileSnapshotId], references: [id], onDelete: Cascade)
  constructId       String
  construct         Construct       @relation(fields: [constructId], references: [id], onDelete: Restrict)
  compositeScore    Float
  facetCount        Int
  standardError     Float? // strictly NULL in pre-calibration
  ci95Lower         Float? // strictly NULL in pre-calibration
  ci95Upper         Float? // strictly NULL in pre-calibration
  normVersionId     String? // strictly NULL in pre-calibration

  @@unique([profileSnapshotId, constructId])
  @@map("construct_scores")
}

model DomainScore {
  id                String          @id @default(cuid())
  profileSnapshotId String
  profileSnapshot   ProfileSnapshot @relation(fields: [profileSnapshotId], references: [id], onDelete: Cascade)
  domainId          String
  domain            Domain          @relation(fields: [domainId], references: [id], onDelete: Restrict)
  compositeScore    Float
  constructCount    Int
  standardError     Float? // strictly NULL in pre-calibration
  ci95Lower         Float? // strictly NULL in pre-calibration
  ci95Upper         Float? // strictly NULL in pre-calibration
  normVersionId     String? // strictly NULL in pre-calibration

  @@unique([profileSnapshotId, domainId])
  @@map("domain_scores")
}

// ---------------------------------------------------------
// FAZ 2.7C SCIENTIFIC AUDIT & VALIDATION EVIDENCE
// ---------------------------------------------------------

model ScientificAuditEvent {
  id               String   @id @default(cuid())
  eventType        String // e.g. "FORM_PUBLISHED", "ITEM_VERSION_CREATED", "SOURCE_VERIFIED"
  actorUserId      String?
  actor            User?    @relation("ScientificAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetEntityType String // e.g. "AssessmentFormVersion", "ItemVersion", "FacetValidationSummary"
  targetEntityId   String?
  ipHash           String?
  userAgent        String?  @db.Text
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([targetEntityType, targetEntityId])
  @@map("scientific_audit_events")
}

model FacetValidationSummary {
  id                              String      @id @default(cuid())
  facetId                         String      @unique
  facet                           Facet       @relation(fields: [facetId], references: [id], onDelete: Restrict)
  overallTurkishEvidenceLevel     String      @default("NO_DIRECT") // "DIRECT", "LEXICAL", "RELATED", "NO_DIRECT"
  overallStatus                   String      @default("NOT_ASSESSED") // "LEXICAL_SUPPORT_ONLY", "DIRECT_VALIDATION", etc.
  measurementAlignmentLevel       String      @default("NOT_APPLICABLE") // "EXACT_FACET", "SUBSCALE_ALIGNED", "CONSTRUCT_ALIGNED", "NOT_APPLICABLE"
  measurementInvarianceStatus     String      @default("NOT_ASSESSED")
  instrumentValidationEstablished Boolean     @default(false)
  targetConstructInstrumentId     String?
  targetConstructInstrument       Instrument? @relation("TargetConstructInstrument", fields: [targetConstructInstrumentId], references: [id], onDelete: Restrict)
  supportingEvidenceInstrumentId  String?
  supportingEvidenceInstrument    Instrument? @relation("SupportingEvidenceInstrument", fields: [supportingEvidenceInstrumentId], references: [id], onDelete: Restrict)
  sampleDescription               String?     @db.Text
  scientificNotes                 String?     @db.Text
  humanVerified                   Boolean     @default(false)
  verifiedAt                      DateTime?
  verifiedByUserId                String?
  verifiedByUser                  User?       @relation("ValidationSummaryVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  createdAt                       DateTime    @default(now())
  updatedAt                       DateTime    @default(now()) @updatedAt

  studyEvidences       FacetValidationStudyEvidence[]
  reliabilityEvidences FacetReliabilityEvidence[]

  @@map("facet_validation_summaries")
}

model FacetValidationStudyEvidence {
  id                        String                 @id @default(cuid())
  validationSummaryId       String
  validationSummary         FacetValidationSummary @relation(fields: [validationSummaryId], references: [id], onDelete: Cascade)
  sourceId                  String?
  source                    ScientificSource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  instrumentId              String?
  instrument                Instrument?            @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  evidenceType              String // "BROAD_FACTOR_LEXICAL_SUPPORT", "DIRECT_EMPIRICAL_ADAPTATION", etc.
  evidenceLevel             String                 @default("NO_DIRECT") // "DIRECT", "LEXICAL", "RELATED", "NO_DIRECT"
  appliesToLevel            String                 @default("FACET") // "SCALE_TOTAL", "SUBSCALE", "FACET", "BROAD_FACTOR"
  measurementAlignmentLevel String                 @default("NOT_APPLICABLE") // "EXACT_FACET", "SUBSCALE_ALIGNED", etc.
  sampleN                   Int? // Sample N belongs to study evidence
  population                String?
  samplingMethod            String?
  doesNotEstablish          Json? // String array of unestablished claims
  factorEvidenceLevel       String? // "SCALE_TOTAL", "SUBSCALE", "FACET", "BROAD_FACTOR"
  factorEvidenceStatus      String? // "SUPPORTED", "PRELIMINARY", "NOT_ASSESSED"
  claimVerificationStatus   String                 @default("NOT_ASSESSED")
  verificationMethod        String?
  humanVerified             Boolean                @default(false)
  notes                     String?                @db.Text
  createdAt                 DateTime               @default(now())

  @@index([validationSummaryId])
  @@map("facet_validation_study_evidences")
}

model FacetReliabilityEvidence {
  id                      String                 @id @default(cuid())
  validationSummaryId     String
  validationSummary       FacetValidationSummary @relation(fields: [validationSummaryId], references: [id], onDelete: Cascade)
  sourceId                String?
  source                  ScientificSource?      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  instrumentId            String?
  instrument              Instrument?            @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  metricType              String // "INTERNAL_CONSISTENCY", "TEST_RETEST"
  metricName              String? // "CRONBACH_ALPHA", "MCDONALD_OMEGA", "PEARSON_R"
  value                   Float? // e.g. 0.84
  interval                String? // e.g. "4 weeks"
  location                String? // e.g. "Table 2, p. 145"
  evidenceLevel           String                 @default("NO_DIRECT") // "DIRECT", "LEXICAL", "RELATED", "NO_DIRECT"
  claimVerificationStatus String                 @default("NOT_ASSESSED")
  humanVerified           Boolean                @default(false)
  createdAt               DateTime               @default(now())

  @@index([validationSummaryId])
  @@map("facet_reliability_evidences")
}

// ---------------------------------------------------------
// FAZ 2.21 USER REFLECTION & OBSERVATIONAL JOURNAL LAYER
// ---------------------------------------------------------

enum JournalEntryType {
  FREE_REFLECTION
  EVENT
  EMOTION
  DECISION
  RELATIONSHIP
  WORK
  GOAL
  STRESS
  SUCCESS
  CHALLENGE
  OTHER
}

enum JournalInsightType {
  ENTRY_REFLECTION
  REPEATED_THEME
  PROFILE_ALIGNMENT
  CONTEXTUAL_VARIATION
  DECISION_REFLECTION
  EMOTIONAL_PATTERN_REFLECTION
  GOAL_REFLECTION
  LONGITUDINAL_CONTEXT_LINK
  OPEN_QUESTION
}

enum JournalEvidenceClass {
  USER_REPORTED_CONTEXT
  OBSERVATIONAL_DATA
  AI_REFLECTIVE_HYPOTHESIS
  THEORETICAL_INTERPRETATION
}

enum JournalRelationshipType {
  ALIGNED_WITH_MEASUREMENT
  DIFFERS_FROM_MEASUREMENT
  CONTEXTUAL_VARIATION
  UNMEASURED_RELEVANT_AREA
  NO_CLEAR_RELATION
}

enum JournalRelationshipStrength {
  WEAK
  MODERATE
  STRONG
}

enum JournalLifeEventType {
  JOB_CHANGE
  RELOCATION
  RELATIONSHIP_TRANSITION
  MAJOR_GOAL
  HIGH_STRESS_PERIOD
  OTHER
}

model JournalEntry {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  title            String?               @db.VarChar(255)
  body             String                @db.Text
  entryType        JournalEntryType      @default(FREE_REFLECTION)

  // Subjective self-report ratings (1-5 scale, strictly non-psychometric)
  moodSelfReport   Int?
  energySelfReport Int?
  stressSelfReport Int?

  // Context & user tags
  contextTags      String[]
  userTags         String[]

  // Explicit user-reported life events (never auto-inferred)
  isLifeEvent      Boolean               @default(false)
  lifeEventType    JournalLifeEventType?

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  // Relations
  insights         JournalInsight[]
  relationships    JournalProfileRelationship[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, entryType])
  @@index([userId, isLifeEvent])
  @@index([userId, deletedAt, createdAt(sort: Desc)])
  @@map("journal_entries")
}

model JournalInsight {
  id                String               @id @default(cuid())
  entryId           String
  entry             JournalEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  insightType       JournalInsightType
  evidenceClass     JournalEvidenceClass @default(USER_REPORTED_CONTEXT)

  summaryTr         String               @db.Text
  reflectivePrompt  String?              @db.Text
  isFallback        Boolean              @default(false)

  // Provenance & versioning
  engineVersion     String               @default("v1.0.0")
  promptVersion     String?
  provider          String?
  modelId           String?
  sourceContentHash String?

  createdAt         DateTime             @default(now())

  @@index([entryId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("journal_insights")
}

model JournalProfileRelationship {
  id                  String                      @id @default(cuid())
  entryId             String
  entry               JournalEntry                @relation(fields: [entryId], references: [id], onDelete: Cascade)

  relationshipType    JournalRelationshipType
  evidenceType        JournalEvidenceClass        @default(OBSERVATIONAL_DATA)
  strength            JournalRelationshipStrength @default(WEAK)

  // Canonical Master Model identifiers (11 domains, 37 constructs, 91 facets)
  relatedFacetIds     String[]
  relatedConstructIds String[]
  relatedDomainIds    String[]

  narrativeTr         String?                     @db.Text
  createdAt           DateTime                    @default(now())

  @@index([entryId])
  @@index([relationshipType])
  @@map("journal_profile_relationships")
}
