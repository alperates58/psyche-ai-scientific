    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
