{
  "name": "psyche-ai-scientific-profile-engine",
  "version": "0.1.0-research",
  "private": true,
  "description": "Research scaffold for a psychometric profile engine with theory lenses and DeepSeek V4 Flash interpretation",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
